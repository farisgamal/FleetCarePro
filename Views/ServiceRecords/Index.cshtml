@model List<ServiceRecord>
@{
    ViewData["Title"] = "Service Records";
}

<div class="d-flex justify-content-between mb-3">
    <h2>Service Records</h2>
    <a asp-action="Create" class="btn btn-success">+ Create New Record</a>
</div>

<table class="table table-striped">
    <thead>
        <tr><th>Date</th><th>Vehicle</th><th>Service Center</th><th>Mileage</th><th>Total Cost</th><th>Status</th><th>Invoice</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.ServiceDate.ToString("yyyy-MM-dd")</td>
                <td>@(r.Vehicle?.LicensePlate)</td>
                <td>@r.ServiceCenter?.Name</td>
                <td>@r.CurrentMileage km</td>
                <td>$@r.TotalCost.ToString("N2")</td>
                <td>
                    @{
                        var badgeClass = r.Status switch
                        {
                            ServiceRecordStatus.Approved => "bg-success",
                            ServiceRecordStatus.Completed => "bg-primary",
                            ServiceRecordStatus.Cancelled => "bg-danger",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @badgeClass">@r.Status</span>
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(r.InvoiceDocumentPath))
                    {
                        <a href="@r.InvoiceDocumentPath" target="_blank">View Invoice</a>
                    }
                    else
                    {
                        <span class="text-muted">No Invoice</span>
                    }
                </td>
                <td>
                    @if (r.Status == ServiceRecordStatus.Pending)
                    {
                        <a asp-action="Approve" asp-route-id="@r.Id" class="btn btn-sm btn-success">Approve</a>
                    }
                    @if (r.Status == ServiceRecordStatus.Approved)
                    {
                        <a asp-action="Complete" asp-route-id="@r.Id" class="btn btn-sm btn-primary">Complete</a>
                    }
                    @if (r.Status != ServiceRecordStatus.Cancelled && r.Status != ServiceRecordStatus.Completed)
                    {
                        <a asp-action="Cancel" asp-route-id="@r.Id" class="btn btn-sm btn-danger" onclick="return confirm('Cancel this record?')">Cancel</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
