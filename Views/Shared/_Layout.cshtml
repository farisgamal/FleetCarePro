<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>FleetCare Pro</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">FleetCare Pro</a>
            <div class="navbar-nav">
                <a class="nav-link text-light" asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-link text-light" asp-controller="Vehicles" asp-action="Index">Vehicles</a>
                <a class="nav-link text-light" asp-controller="ServiceCategories" asp-action="Index">Categories</a>
                <a class="nav-link text-light" asp-controller="ServiceCenters" asp-action="Index">Service Centers</a>
                <a class="nav-link text-light" asp-controller="ServiceRecords" asp-action="Index">Service Records</a>
                <a class="nav-link text-light" asp-controller="Home" asp-action="Analytics">Analytics</a>
            </div>
            <div class="navbar-nav ms-auto">
                @if (User.Identity is not null && User.Identity.IsAuthenticated)
                {
                    <span class="nav-link text-light">Hello, @User.Identity.Name!</span>
                    <a class="nav-link text-warning" asp-controller="Account" asp-action="Logout">Logout</a>
                }
                else
                {
                    <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="nav-link text-light" asp-controller="Account" asp-action="Register">Register</a>
                }
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["Success"] is not null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @RenderBody()
    </div>

    <footer class="container text-center text-muted mt-5 mb-3">
        &copy; @DateTime.Now.Year - FleetCarePro
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
