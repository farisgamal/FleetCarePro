@model ServiceCategory
@{
    ViewData["Title"] = "Add Service Category";
}

<h2>Add Service Category</h2>
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create" method="post" style="max-width:500px;">
    <div class="mb-3"><label>Category Name</label><input asp-for="CategoryName" class="form-control" /></div>
    <div class="mb-3"><label>Description</label><input asp-for="Description" class="form-control" /></div>
    <div class="mb-3"><label>Recommended Interval (months)</label><input asp-for="RecommendedIntervalMonths" class="form-control" /></div>
    <button type="submit" class="btn btn-success">Save</button>
</form>
<a asp-action="Index" class="btn btn-secondary mt-2">Back</a>
